# Copy this file to .env and adjust as needed.

# Whisper model size. Larger = more accurate but slower. On CPU, base.en/small.en
# are the practical range for real-time use.
STT_MODEL=base.en

# "cpu", "cuda" (only if you have an NVIDIA GPU with CUDA installed), or "auto".
STT_DEVICE=cpu

# Quantization for faster-whisper. int8 is the fastest on CPU.
# One of: default, auto, int8, int8_float32, int8_float16, int8_bfloat16,
# int16, float16, bfloat16, float32.
STT_COMPUTE_TYPE=int8

STT_LANGUAGE=en

# Silero VAD's speech-detection threshold: 0 (least sensitive) to 1 (most).
# App default is 0.3 (RealtimeSTT's own default is 0.4). Lower this if she
# barges in on / cuts off her own replies for background noise; raise it if
# she stops responding to your actual speech.
STT_SILERO_SENSITIVITY=0.3

# Windows SAPI5 voice name (or substring) to speak with. Leave blank for the OS default.
# List available voices with:
#   python -c "import win32com.client; [print(v.GetDescription()) for v in win32com.client.Dispatch('SAPI.SpVoice').GetVoices()]"
TTS_VOICE=

# Max seconds to wait for a single TTS phrase to finish playing before giving
# up on it (guards against a hung SAPI5 call).
TTS_TIMEOUT_SECONDS=15

# Set to true to show a talking-head window instead of audio-only TTS: a 2D
# image you provide gets its mouth animated in sync with speech. See
# docs/design/004-talking-head.md. Requires AVATAR_IMAGE_PATH and the
# Rhubarb Lip Sync binary (see README setup instructions).
AVATAR_ENABLED=false

# Path to a 2D image (PNG/JPG) with a clearly visible face/mouth. Only used
# when AVATAR_ENABLED=true.
AVATAR_IMAGE_PATH=

# Path to rhubarb.exe (from https://github.com/DanielSWolf/rhubarb-lip-sync
# /releases). Only used when AVATAR_ENABLED=true.
RHUBARB_PATH=rhubarb.exe

# Max seconds to wait for one avatar phrase (synthesis + lip-sync analysis +
# playback) before giving up on it.
AVATAR_TIMEOUT_SECONDS=15

# Free API key from https://console.groq.com/keys (no credit card required).
GROQ_API_KEY=

# See https://console.groq.com/docs/models for the current list (llama-3.1-8b-instant
# was decommissioned by Groq). openai/gpt-oss-20b is small/fast (best for a
# live-conversation feel); openai/gpt-oss-120b is slower but higher quality if
# 20b's replies feel shallow.
LLM_MODEL=openai/gpt-oss-20b

# How many of the most recent user/assistant exchanges to resend as context each turn.
LLM_HISTORY_TURNS=6

# Max seconds to wait for a Groq response before giving up.
LLM_TIMEOUT_SECONDS=10

# Uncomment to override the default persona (kept short since TTS reads it aloud).
# LLM_SYSTEM_PROMPT=You are ...

LOG_LEVEL=INFO
